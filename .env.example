# ─── Supabase ───────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY, never exposed to the browser.
# Used by the admin panel for writes + Storage uploads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public Storage bucket name for gallery images (create it in Supabase Storage).
SUPABASE_GALLERY_BUCKET=gallery

# ─── Admin panel ────────────────────────────────────────────
# The single owner password used to log into /admin.
ADMIN_PASSWORD=change-this-to-something-long

# Random secret used to sign the admin session cookie.
# Generate one: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ─── Site ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bmwcoding.ie
