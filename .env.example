# ─── Supabase ───────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY, never exposed to the browser.
# Used by the admin panel for writes + Storage uploads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public Storage bucket name for gallery images (create it in Supabase Storage).
SUPABASE_GALLERY_BUCKET=gallery

# ─── Admin panel ────────────────────────────────────────────
# The single owner password used to log into /admin.
ADMIN_PASSWORD=change-this-to-something-long

# Random secret used to sign the admin session cookie.
# Generate one: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ─── Site ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bmwcoding.ie

# ─── Telegram bot (booking notifications) ───────────────────
# From @BotFather. The bot sends booking/enquiry alerts to your chat.
TG_TOKEN=123456:your-bot-token
# Your personal/group chat id (talk to @userinfobot to find yours).
TG_CHAT_ID=123456789
# Shared secret that protects the booking webhook (confirm/decline buttons).
# Generate one: openssl rand -hex 16 — then register the webhook once:
#   https://api.telegram.org/bot<TG_TOKEN>/setWebhook?url=https://bmwcoding.ie/api/telegram&secret_token=<TG_WEBHOOK_SECRET>
TG_WEBHOOK_SECRET=replace-with-a-random-string

# Google Business Profile review link (Share -> Ask for reviews). Powers the
# "Ask review" button in the Mini App and the morning review nudges.
GOOGLE_REVIEW_URL=https://g.page/r/XXXXXXXX/review

# ─── WhatsApp AI auto-responder (Meta Cloud API) ────────────
# From developers.facebook.com → your app → WhatsApp → API Setup.
# The bot answers customers with AI and mirrors every chat to Telegram.
# WARNING: the number you register with the Cloud API can NOT be used in
# the normal WhatsApp app at the same time — use a dedicated number.
WHATSAPP_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_ID=123456789012345
# Any random string; enter the same value in the Meta webhook config.
# Webhook URL: https://www.bmwcoding.ie/api/whatsapp
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-string
# Optional: app secret enables webhook signature verification.
WHATSAPP_APP_SECRET=

# ─── Ad platform tags (conversion tracking, consent-gated) ──
# Google Ads: Tools → Conversions → your action → "AW-…" id + label.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-1234567890
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=AbCdEfGhIj
# Meta (Facebook/Instagram) Pixel id from Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=1234567890
